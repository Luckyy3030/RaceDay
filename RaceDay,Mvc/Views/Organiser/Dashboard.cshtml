@model List<RaceDay.Mvc.Models.EventViewModel>

<div class="container mt-4">
    <h1>Organiser Dashboard</h1>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <a asp-action="CreateEvent"
       class="btn btn-primary mb-3">
        Create Event
    </a>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not created any events yet.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow p-3 h-100">

                        <h4>@item.Name</h4>

                        <img src="@Url.Action("EventBannerImage", "Organiser", new { id = item.EventId })"
                             alt="Banner for @item.Name"
                             class="img-fluid rounded mb-3"
                             style="width:100%; height:180px; object-fit:cover;"
                             onerror="this.style.display='none';" />

                        <p>@item.Description</p>

                        <p>
                            <strong>Location:</strong>
                            @item.Location
                        </p>

                        <p>
                            <strong>Date:</strong>
                            @item.EventDate.ToString("dd MMM yyyy")
                        </p>

                        <p>
                            <strong>Distance:</strong>
                            @item.Distance.ToString("0.##") km
                        </p>

                        <p>
                            <strong>Event Type:</strong>
                            @item.EventType
                        </p>

                        <hr />

                        <h5>Upload Event Banner</h5>

                        <form asp-action="UploadBanner"
                              asp-route-id="@item.EventId"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <input type="file"
                                       name="file"
                                       class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp"
                                       required />
                            </div>

                            <button type="submit"
                                    class="btn btn-success w-100 mb-3">
                                Upload Banner
                            </button>
                        </form>

                        <form asp-action="DeleteEvent"
                              asp-route-id="@item.EventId"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this event?');">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger w-100">
                                Delete Event
                            </button>
                        </form>

                    </div>
                </div>
            }
        </div>
    }
</div>
